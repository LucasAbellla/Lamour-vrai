# Ambiente visualizado em diagnósticos e builds.
VITE_APP_ENV=development

# Use "local" somente no desenvolvimento. A publicação real usa "supabase" nos dois campos.
VITE_AUTH_MODE=local
VITE_DATA_MODE=local
VITE_STORAGE_NAMESPACE=lamour-vrai

# A URL e a chave publicável (anon/publishable) podem chegar ao navegador.
# Nunca use SUPABASE_SERVICE_ROLE_KEY ou qualquer segredo administrativo aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
