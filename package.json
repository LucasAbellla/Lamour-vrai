{
  "name": "lamour-vrai",
  "version": "0.4.0",
  "private": true,
  "description": "Um arquivo afetivo particular para guardar memórias, cartas e sonhos.",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/generate-icons.mjs",
    "build": "vite build",
    "build:local": "vite build --mode development",
    "preview": "vite preview",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:security": "node tests/security.mjs",
    "test:backup": "node tests/backup.mjs",
    "test:story": "node tests/story.mjs",
    "desktop": "npm run build:local && electron .",
    "start": "npm run desktop",
    "check": "npm run test:security && npm run test:backup && npm run test:story && npm run build:local && node --check main.js"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^2.0.0"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2"
  }
}
