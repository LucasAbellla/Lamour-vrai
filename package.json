{
  "name": "lamour-vrai",
  "version": "0.4.0",
  "private": true,
  "description": "Um arquivo afetivo particular para guardar memórias, cartas e sonhos.",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/generate-icons.mjs",
    "build": "vite build",
    "build:local": "vite build --mode development",
    "preview": "vite preview",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:security": "node tests/security.mjs",
    "test:backup": "node tests/backup.mjs",
    "test:story": "node tests/story.mjs",
    "test:db": "node tests/database.mjs",
    "desktop": "npm run build:local && electron .",
    "desktop:build": "electron-builder --win",
    "start": "npm run desktop",
    "check": "npm run test:security && npm run test:backup && npm run test:story && npm run test:db && npm run build:local && node --check main.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/pinyon-script": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^2.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "author": "Lucas Abella",
  "build": {
    "appId": "app.lamourvrai.desktop",
    "productName": "L'amour vrai",
    "artifactName": "Lamour-vrai-Instalador.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "desktop/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "LucasAbellla",
      "repo": "Lamour-vrai",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "L'amour vrai",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
